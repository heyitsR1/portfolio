{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "portfolio",
  "account_id": "ec29d3d5939b0b457f6ea1f8e91a9dc5",
  "main": "cf/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Exact paths only (Vercel didn't rewrite /x.html to /x); the worker adds directory indexes.
    "html_handling": "none",
    "not_found_handling": "none",
    // The worker must see every request to redirect the bare domain to www.
    "run_worker_first": true
  },
  // Worker Routes on the existing proxied DNS records (the old Vercel CNAME/A stay but are never reached:
  // the worker answers everything from its assets). The worker redirects the apex to www.
  // To switch to Workers Custom Domains: delete the apex and www DNS records in the dashboard, then use
  // { "pattern": "www.aarohanniraula.com.np", "custom_domain": true } (and the same for the apex) instead.
  "routes": [
    { "pattern": "www.aarohanniraula.com.np/*", "zone_name": "aarohanniraula.com.np" },
    { "pattern": "aarohanniraula.com.np/*", "zone_name": "aarohanniraula.com.np" }
  ]
}
